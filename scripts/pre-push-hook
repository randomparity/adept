#!/usr/bin/env bash
# adept: managed pre-push hook
set -euo pipefail

# `git rev-parse --show-toplevel` exits non-zero for more than "you are not in a
# worktree": dubious ownership under a bind mount or a container UID mismatch, an
# unreadable or damaged .git, an unreadable parent directory. The old diagnostic
# asserted the first of those and discarded git's own line, which for dubious
# ownership carries the exact safe.directory remedy -- and this is the hook, so it
# runs before anything else can report and that line is the only diagnostic the
# operator would ever have seen. Report what was established instead: the command
# and the status it returned. Same wording as scripts/verify-push.sh, which this
# hook invokes through `just push-check`.
root_status=0
ROOT=$(git rev-parse --show-toplevel) || root_status=$?
if [ "$root_status" -ne 0 ]; then
	printf 'pre-push: could not resolve the worktree root (git rev-parse --show-toplevel exit %s)\n' \
		"$root_status" >&2
	exit 2
fi
cd "$ROOT"
exec just push-check
