#!/usr/bin/env bash
# Print the absolute path of the scratch directory this skill's helpers write
# into, creating it if it is not there yet. Task briefs, implementer reports,
# review packages and the progress ledger all land in it, and all of them are
# disposable once the task they belong to is finished.
#
# Why it sits in the working tree rather than under .git/: Codex's
# workspace-write sandbox refuses writes below .git/, and an implementer subagent
# that cannot write its report has no way to report.
#
# Why the ignore file covers .agent/ rather than .agent/sdd/: $campaign writes a
# sibling .agent/campaigns/ later, and pinning the ignore one level down would
# leave whichever skill happened to run first deciding whether the other's state
# is ignored.
#
# Every helper resolves the directory by calling this script, so task-brief and
# review-package cannot end up disagreeing about where it is.
#
# Usage: sdd-workspace
set -euo pipefail

top=$(git rev-parse --show-toplevel)

# A repository may legitimately track its own .agent/.gitignore -- the name is
# generic enough -- and overwriting one would destroy exactly what this check
# exists to protect. So keep all three answers distinct instead of testing the
# command as a boolean: 0 means tracked, 1 means untracked, and anything else
# (127 without git, 128 outside a repository or on a bad -C path) means the
# question went unanswered. Collapsing that third case into "untracked" is how
# the file would get clobbered. Output goes to /dev/null because the untracked
# answer arrives as a pathspec error on stderr; the exit status carries the
# meaning.
ignore="$top/.agent/.gitignore"
state=0
git -C "$top" ls-files --error-unmatch .agent/.gitignore >/dev/null 2>&1 || state=$?

scratch="$top/.agent/sdd"
mkdir -p "$scratch"
chmod 700 "$scratch"

case "$state" in
0)
	# Tracked is not by itself a reason to stop. A repository that keeps its own
	# ignore file and already covers this directory is the harmless case, and
	# refusing there would break task-brief and review-package for no gain. Judge
	# the outcome rather than the mechanism, and stop only when the scratch
	# directory is genuinely left exposed.
	if ! git -C "$top" check-ignore -q .agent/sdd/; then
		printf 'sdd-workspace: %s is tracked here and does not ignore .agent/sdd/; refusing to modify it\n' \
			"$ignore" >&2
		exit 1
	fi
	;;
1)
	# Write to a temporary file and rename over the target. A plain redirect
	# truncates first and fills afterwards, and $campaign's fail-closed
	# `git check-ignore` reading during that window sees an empty ignore file,
	# concludes the manifest is unignored, and halts the run. rename(2) inside one
	# directory is atomic, so a concurrent reader gets the old file or the new one
	# and never the gap. The trap earns its place as much as the rename does:
	# without it an interrupted run strands a .gitignore.XXXXXX and leaves nothing
	# ignoring it, which is the exposure this branch exists to avoid.
	staging=$(mktemp "$top/.agent/.gitignore.XXXXXX")
	trap 'rm -f "$staging"' EXIT
	printf '*\n' >"$staging"
	# mktemp hands back 0600. Nothing here is secret, and git has to be able to
	# read it whatever umask the calling skill left behind.
	chmod 644 "$staging"
	mv -f "$staging" "$ignore"
	trap - EXIT
	;;
*)
	printf 'sdd-workspace: cannot determine whether %s is tracked (git exited %s)\n' \
		"$ignore" "$state" >&2
	exit 1
	;;
esac

# Deliberately not `cd && pwd`: a cd that failed would exit non-zero having
# printed nothing, and both callers read this script's stdout, so neither side
# would have a diagnostic to offer.
cd "$scratch" || {
	printf 'sdd-workspace: cannot enter %s\n' "$scratch" >&2
	exit 1
}
pwd
