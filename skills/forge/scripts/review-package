#!/usr/bin/env bash
# Collect everything a reviewer needs about one revision range into a single
# readable file: which commits landed, which files moved, and the whole net diff
# with wide context, so a hunk can be judged without opening the tree.
#
# The range is supplied rather than assumed to be the last commit. A task often
# lands as several commits, and reviewing only the tip hides the rest of it.
#
# Usage: review-package FROM TO [DESTINATION]
#
# Without DESTINATION the file lands in the shared scratch directory, keyed to
# the abbreviated range, so re-reviewing after a fix writes somewhere new rather
# than overwriting the reading it should be compared against.
set -euo pipefail

case $# in
2 | 3) ;;
*)
	printf 'usage: review-package FROM TO [DESTINATION]\n' >&2
	exit 2
	;;
esac

from=$1
to=$2

# Both endpoints are checked before anything is written, so a typo in the second
# one cannot leave a half-built package behind.
for endpoint in "$from" "$to"; do
	if ! git rev-parse --verify --quiet "$endpoint" >/dev/null; then
		printf 'review-package: %s does not name a revision here\n' "$endpoint" >&2
		exit 2
	fi
done

# An empty range would otherwise write a well-formed package describing
# nothing and exit 0, which every downstream reader takes as evidence that a
# diff exists. A task whose BASE and HEAD name no commits in between is a
# worker that committed nowhere -- exactly the failure an orchestrator must
# not mistake for a clean task -- so it fails loudly here instead.
span="$from..$to"
commits=$(git rev-list --count "$span")
if [ "$commits" -eq 0 ]; then
	printf 'review-package: %s contains no commits\n' "$span" >&2
	printf 'review-package: check both endpoints and their order -- nothing sits between them\n' >&2
	exit 2
fi

if [ $# -eq 3 ]; then
	destination=$3
else
	scratch=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
	abbreviated="$(git rev-parse --short "$from")..$(git rev-parse --short "$to")"
	destination="$scratch/review-$abbreviated.diff"
fi

{
	printf '# Review package: %s\n\n' "$span"
	printf '## Commits\n'
	git log --oneline "$span"
	printf '\n## Files changed\n'
	git diff --stat "$span"
	printf '\n## Diff\n'
	git diff -U10 "$span"
} >"$destination"

printf 'review-package: wrote %s (%s commit(s), %s bytes)\n' \
	"$destination" \
	"$commits" \
	"$(wc -c <"$destination" | tr -d ' ')"
