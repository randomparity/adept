#!/usr/bin/env bash
# Publish one complete WORK:REVIEW annotation, verify GitHub's exact copy, then
# recoverably dispose its local inputs only after recording that verification.
set -euo pipefail

OUTER_MARKER='<!-- WORK:REVIEW -->'
OUTER_SENTINEL='<!-- REVIEW:COMPLETE -->'
MAX_SOURCE_BYTES=4096
MAX_BODY_BYTES=32768
SCRIPT_DIR=${BASH_SOURCE[0]%/*}
[ "$SCRIPT_DIR" = "${BASH_SOURCE[0]}" ] && SCRIPT_DIR=.
SCRIPT_DIR=$(cd "$SCRIPT_DIR" && pwd)
body=''
gh_capture=''
# Seconds. gh pr comment issues a lookup and a mutation; gh api issues one
# request. references/network-bounds.md carries the rule, ADR 0068 the record.
# The overrides exist so the behaviour suite can reach each bound without a real
# wait, and set them apart so a transposition is observable; no caller sets them.
BOUND_MULTI=${PUBLISH_FORGE_REVIEW_BOUND_MULTI:-120}
BOUND_SINGLE=${PUBLISH_FORGE_REVIEW_BOUND_SINGLE:-30}
disposer=''
repo=''
pr=''
mode=''
operation=publish
review_or_reason=''
ledger=''
summary=''
payload=''
comment_url=''
platform=''
ledger_directory=''

finish_body_lifecycle() {
	local exit_status
	exit_status=$?
	# Failures deliberately leave the checked body beside the ledger for recovery.
	[ "$exit_status" -ne 0 ] && return "$exit_status"
	if [ -n "$body" ] && [ -e "$body" ]; then
		printf 'publish-forge-review: successful publication left its body behind\n' >&2
		return 1
	fi
	return 0
}

trap finish_body_lifecycle EXIT

fail() {
	# Every fatal path runs through here, so this is the one place a gh capture
	# needs removing. The composed body is deliberately retained instead, by the
	# exit trap.
	if [ -n "$gh_capture" ] && [ -e "$gh_capture" ]; then
		rm -f -- "$gh_capture" ||
			printf 'publish-forge-review: retained gh capture: %s\n' "$gh_capture" >&2
	fi
	printf 'publish-forge-review: %s\n' "$1" >&2
	exit 1
}

# Run a command under a bound. Returns the command's own status, or 124 when the
# bound was exceeded. stdout and stderr land in separate caller-owned files.
# Transcribed from references/network-bounds.md; ADR 0068 carries the reasoning.
bounded_call() { # seconds out-file err-file command...
	# rc, not status: under zsh `status` is a read-only special parameter, and a
	# `local status=0` in a sourced body once killed a caller's whole session --
	# cleared-dependencies.sh:5-16 carries that record.
	local bound=$1 out=$2 err=$3 pid waited=0 grace=0 rc=0
	shift 3
	"$@" >"$out" 2>"$err" &
	pid=$!
	# Tenths, so the counter stays integer arithmetic on a Bash 3.2 floor.
	while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$((bound * 10))" ]; do
		sleep 0.1
		waited=$((waited + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		# TERM, then KILL only if TERM does not land. Never a bare KILL.
		kill -TERM "$pid" 2>/dev/null || :
		while kill -0 "$pid" 2>/dev/null && [ "$grace" -lt 20 ]; do
			sleep 0.1
			grace=$((grace + 1))
		done
		kill -KILL "$pid" 2>/dev/null || :
		wait "$pid" 2>/dev/null || :
		# The writer was killed mid-stream, so the capture is void. Emptying it
		# here makes that structural: a site that parses it anyway gets nothing,
		# not a truncated page that reads as a complete short one.
		: >"$out"
		return 124
	fi
	wait "$pid" || rc=$?
	return "$rc"
}

# One bounded gh call. Its stdout is left at gh_capture for the caller to read
# and remove; its stderr is forwarded to this script's own, which is where gh's
# stderr went before either call was captured at all.
run_gh() { # seconds gh-args...
	local bound=$1 err rc=0 forward_status=0
	shift
	gh_capture=$(mktemp) || fail 'cannot create a gh stdout capture'
	err=$(mktemp) || fail 'cannot create a gh stderr capture'
	bounded_call "$bound" "$gh_capture" "$err" gh "$@" || rc=$?
	if [ -s "$err" ]; then
		cat -- "$err" >&2 || forward_status=$?
	fi
	# Removal precedes the forwarding verdict so a failed read still frees the
	# capture: fail() reaches gh_capture, and this file is local to run_gh.
	rm -f -- "$err" ||
		printf 'publish-forge-review: retained gh stderr capture: %s\n' "$err" >&2
	[ "$forward_status" -eq 0 ] || fail 'cannot read a gh stderr capture'
	return "$rc"
}

preflight() {
	local command bound
	for command in gh jq rg mktemp awk git iconv od grep sed dirname tail uname cat chmod stat wc rm; do
		command -v "$command" >/dev/null 2>&1 ||
			fail "required command is unavailable: $command; install it or expose it in PATH"
	done
	platform=$(uname -s)
	case $platform in
	Darwin) disposer=trash ;;
	Linux) disposer=gio ;;
	*) fail 'no supported recoverable-delete command on this platform' ;;
	esac
	command -v "$disposer" >/dev/null 2>&1 ||
		fail "recoverable-delete command is unavailable: $disposer; install it or expose it in PATH"
	# Each bound separately, never the concatenation: a leading zero on the second
	# value disappears inside it. Digits alone are not enough for the arithmetic
	# destination -- bash reads 010 as octal 8, so a site would run under a bound
	# nobody chose, and 08 is an arithmetic error. Measured on bash 3.2.57: that
	# error lands in bounded_call's `while` condition, where `set -e` is suspended,
	# so it does not abort -- the poll is abandoned, the function returns 0 with an
	# empty capture, and the child it launched survives. The caller then reads a
	# successful call that answered nothing, which is exactly the reading this
	# convention exists to prevent, with the orphan the bound exists to reap. The
	# length cap keeps the multiplication clear of 64-bit overflow.
	for bound in "$BOUND_MULTI" "$BOUND_SINGLE"; do
		case $bound in
		'' | *[!0-9]* | 0?*)
			fail 'network bound override must be a whole number of seconds with no leading zero'
			;;
		esac
		[ "${#bound}" -le 7 ] ||
			fail 'network bound override is implausibly large; give a whole number of seconds'
	done
	[ -x "$SCRIPT_DIR/check-public-safety" ] ||
		fail 'bundled public-safety check is unavailable; repair the installed quest skill'
}

validate_arguments() {
	if [ "${1-}" = --preflight ]; then
		operation=preflight
		shift
	fi
	case $# in
	6 | 7) ;;
	*) fail 'usage: publish-forge-review [--preflight] REPO PR MODE REVIEW-OR-REASON LEDGER SUMMARY [PAYLOAD]' ;;
	esac
	repo=$1
	pr=$2
	mode=$3
	review_or_reason=$4
	ledger=$5
	summary=$6
	payload=${7-}
	case $repo in
	*/*)
		case $repo in *'/'*'/'* | *[!A-Za-z0-9_.-/'-']*) fail 'repository is invalid' ;; esac
		;;
	*) fail 'repository is invalid' ;;
	esac
	case $pr in '' | *[!0-9]* | 0) fail 'pull request is invalid' ;; esac
	case $mode in required | not-required) ;; *) fail 'publication mode is invalid' ;; esac
}

mode_of() {
	local actual_mode
	actual_mode=$(stat -f %Lp "$1" 2>/dev/null) || actual_mode=''
	case $actual_mode in
	[0-7][0-7][0-7] | [0-7][0-7][0-7][0-7])
		printf '%s\n' "$actual_mode"
		;;
	*)
		stat -c %a "$1"
		;;
	esac
}

require_private_directory() {
	local path=$1 actual_mode
	[ -d "$path" ] && [ ! -L "$path" ] || fail 'ledger directory is invalid'
	actual_mode=$(mode_of "$path") || fail 'ledger directory mode cannot be read'
	case $actual_mode in
	700 | 0700) ;;
	*) fail 'ledger directory is not private' ;;
	esac
}

require_private_file() {
	local label=$1 path=$2 need_content=$3 actual_mode
	[ -f "$path" ] && [ ! -L "$path" ] && [ -r "$path" ] || fail "$label is invalid"
	[ "$need_content" = false ] || [ -s "$path" ] || fail "$label is invalid"
	actual_mode=$(mode_of "$path") || fail "$label mode cannot be read"
	case $actual_mode in
	600 | 0600) ;;
	*) fail "$label is not private" ;;
	esac
}

check_size() {
	local label=$1 path=$2 maximum=$3 byte_count
	byte_count=$(wc -c <"$path") || fail "$label cannot be read"
	byte_count=${byte_count//[[:space:]]/}
	case $byte_count in
	'' | *[!0-9]*) fail "$label size is invalid" ;;
	esac
	[ "$byte_count" -le "$maximum" ] || fail "$label exceeds local size limit"
}

check_string_size() {
	local label=$1 value=$2 maximum=$3 byte_count
	byte_count=$(printf '%s' "$value" | wc -c) || fail "$label cannot be read"
	byte_count=${byte_count//[[:space:]]/}
	case $byte_count in
	'' | *[!0-9]*) fail "$label size is invalid" ;;
	esac
	[ "$byte_count" -le "$maximum" ] || fail "$label exceeds local size limit"
}

contains_byte() {
	local byte=$1 path=$2 od_status awk_status statuses
	if LC_ALL=C od -An -v -t x1 "$path" |
		awk -v byte="$byte" '{ for (i = 1; i <= NF; i += 1) if ($i == byte) found = 1 }
			END { exit found ? 0 : 1 }'; then
		statuses=("${PIPESTATUS[@]}")
	else
		statuses=("${PIPESTATUS[@]}")
	fi
	od_status=${statuses[0]}
	awk_status=${statuses[1]}
	[ "$od_status" -eq 0 ] || fail "$path cannot be read"
	case $awk_status in
	0) return 0 ;;
	1) return 1 ;;
	*) fail "$path byte validation failed" ;;
	esac
}

require_publishable_source() {
	local label=$1 path=$2 marker marker_status
	require_private_file "$label" "$path" true
	check_size "$label" "$path" "$MAX_SOURCE_BYTES"
	iconv -f UTF-8 -t UTF-8 "$path" >/dev/null 2>&1 || fail "$label is not UTF-8 text"
	if contains_byte 00 "$path"; then fail "$label contains NUL"; fi
	if contains_byte 0d "$path"; then fail "$label contains carriage return"; fi
	for marker in "$OUTER_MARKER" "$OUTER_SENTINEL"; do
		marker_status=0
		grep -qxF "$marker" "$path" >/dev/null 2>&1 || marker_status=$?
		case $marker_status in
		0) fail "$label contains an outer annotation marker" ;;
		1) ;;
		*) fail "$label marker validation failed" ;;
		esac
	done
}

validate_content() {
	ledger_directory=$(dirname "$ledger") || fail 'ledger directory is invalid'
	require_private_directory "$ledger_directory"
	require_private_file 'publication ledger' "$ledger" false
	[ -w "$ledger" ] || fail 'publication ledger is invalid'
	require_publishable_source 'summary' "$summary"
	if [ -n "$payload" ]; then
		require_publishable_source 'payload' "$payload"
	fi
	case $mode in
	required)
		require_private_file 'required review' "$review_or_reason" true
		;;
	not-required)
		[ -n "$review_or_reason" ] || fail 'not-required reason is invalid'
		check_string_size 'not-required reason' "$review_or_reason" "$MAX_SOURCE_BYTES"
		;;
	esac
}

compose_body() {
	local last_byte
	body=$(mktemp "$ledger_directory/.publish-forge-review.XXXXXX") ||
		fail 'cannot create publication body'
	chmod 600 "$body" || fail 'cannot secure publication body'
	require_private_file 'publication body' "$body" false
	printf '%s\n' "$OUTER_MARKER" >"$body" || fail 'cannot compose publication body'
	cat "$summary" >>"$body" || fail 'cannot read publication summary'
	printf '\n## Forge whole-branch review\n' >>"$body" || fail 'cannot compose publication body'
	case $mode in
	required)
		sed 's/^/    /' "$review_or_reason" >>"$body" || fail 'cannot read required review'
		last_byte=$(tail -c 1 "$review_or_reason") || fail 'cannot read required review'
		[ -z "$last_byte" ] || printf '\n' >>"$body" || fail 'cannot compose publication body'
		;;
	not-required)
		printf '%s\n' "forge review: not required ($review_or_reason)" |
			sed 's/^/    /' >>"$body" || fail 'cannot compose publication body'
		;;
	esac
	if [ -n "$payload" ]; then
		printf '\n## Review exit payloads\n' >>"$body" ||
			fail 'cannot compose publication body'
		cat "$payload" >>"$body" || fail 'cannot read publication payload'
		last_byte=$(tail -c 1 "$payload") || fail 'cannot read publication payload'
		[ -z "$last_byte" ] || printf '\n' >>"$body" || fail 'cannot compose publication body'
	fi
	printf '%s\n' "$OUTER_SENTINEL" >>"$body" || fail 'cannot compose publication body'
	check_size 'publication body' "$body" "$MAX_BODY_BYTES"
	local scan_status=0
	# Scanner diagnostics contain matched private content; expose only the outcome.
	"$SCRIPT_DIR/check-public-safety" "$body" >/dev/null 2>&1 || scan_status=$?
	case $scan_status in
	0) ;;
	1) fail 'publication body contains unsafe content; redact the retained body and source inputs' ;;
	*) fail "public-safety scan could not complete (exit $scan_status); check scanner dependencies and input access" ;;
	esac
}

post_comment() {
	local post_status=0 candidate
	run_gh "$BOUND_MULTI" pr comment "$pr" --repo "github.com/$repo" \
		--body-file "$body" || post_status=$?
	case $post_status in
	0) ;;
	124)
		# A bound does not make a write atomic. Report indeterminacy, never
		# failure, and never retry.
		fail "comment creation exceeded its ${BOUND_MULTI}s bound; the comment may or may not have been created; inspect the pull request before any further attempt"
		;;
	*) fail 'comment creation did not complete' ;;
	esac
	# Through a redirect, not as an operand: awk reads an operand of the form
	# name=value as an assignment rather than a file, and this matches the shape
	# the sibling applier already merged.
	candidate=$(awk 'NF { count += 1; value = $0 } END { if (count == 1) print value }' \
		<"$gh_capture") || fail 'comment creation returned no readable identity'
	rm -f -- "$gh_capture" ||
		printf 'publish-forge-review: retained gh capture: %s\n' "$gh_capture" >&2
	gh_capture=''
	[ -n "$candidate" ] || fail 'comment creation returned no usable identity'
	printf '%s\n' "$candidate"
}

read_comment() {
	local comment_url=$1 expected_prefix comment_id endpoint api_status=0
	expected_prefix="https://github.com/$repo/pull/$pr#issuecomment-"
	case $comment_url in
	"$expected_prefix"*) comment_id=${comment_url#"$expected_prefix"} ;;
	*) fail 'comment creation returned an unexpected identity' ;;
	esac
	case $comment_id in '' | *[!0-9]*) fail 'comment creation returned an invalid identity' ;; esac
	endpoint="/repos/$repo/issues/comments/$comment_id"
	run_gh "$BOUND_SINGLE" api --hostname github.com "$endpoint" || api_status=$?
	if [ "$api_status" -ne 0 ]; then
		# The comment exists and this run cannot prove it does; naming it is what
		# keeps the operator from posting a second one looking for the first.
		printf 'publish-forge-review: posted but unverified comment: %s\n' "$comment_url" >&2
		case $api_status in
		124)
			fail "comment readback exceeded its ${BOUND_SINGLE}s bound; the annotation was posted but could not be verified"
			;;
		*) fail 'comment readback failed' ;;
		esac
	fi
	if ! jq -e --rawfile expected "$body" '.body == $expected' <"$gh_capture" >/dev/null; then
		printf 'publish-forge-review: posted but unverified comment: %s\n' "$comment_url" >&2
		fail 'comment readback did not match the checked body'
	fi
	rm -f -- "$gh_capture" ||
		printf 'publish-forge-review: retained gh capture: %s\n' "$gh_capture" >&2
	gh_capture=''
}

append_ledger() {
	local line=$1 readback append_status=0 read_status=0
	printf '%s\n' "$line" >>"$ledger" || append_status=$?
	if [ "$append_status" -ne 0 ]; then
		printf 'publish-forge-review: verified comment retained: %s\n' "$comment_url" >&2
		fail 'publication ledger append failed'
	fi
	readback=$(tail -n 1 "$ledger") || read_status=$?
	if [ "$read_status" -ne 0 ] || [ "$readback" != "$line" ]; then
		printf 'publish-forge-review: verified comment retained: %s\n' "$comment_url" >&2
		fail 'publication ledger readback failed'
	fi
}

run_disposer() { # candidate
	case $disposer in
	trash) trash "$1" ;;
	gio) gio trash "$1" ;;
	esac
}

# Disposal runs only after the verified ledger line, so the run's product is already
# durable and a disposer that refuses a path -- gio trash declines system-internal
# mounts -- is reported rather than fatal. The ledger, not the exit status, says whether
# publication happened. Every path is attempted: a filesystem that refuses one usually
# refuses all of them, and one odd path must not strand the rest.
dispose() {
	local candidate disposed=() remaining=()
	for candidate in "$@"; do
		# Partition on what is left on disk, never on the disposer's status: one that
		# errors after removing the path leaves nothing to retain, and one that reports
		# success without removing it leaves something that does. The previous
		# implementation reported its remaining paths the same way.
		run_disposer "$candidate" || : # scan-fault: deliberate — the filesystem check below is the verdict
		if [ -e "$candidate" ]; then
			remaining[${#remaining[@]}]=$candidate
		else
			disposed[${#disposed[@]}]=$candidate
		fi
	done
	if [ "${#disposed[@]}" -gt 0 ]; then
		append_ledger "review-publication-disposed: ${disposed[*]}"
	fi
	[ "${#remaining[@]}" -gt 0 ] || return 0
	printf 'publish-forge-review: recoverable disposal failed; remaining paths: %s\n' \
		"${remaining[*]}" >&2
	append_ledger "review-publication-undisposed: ${remaining[*]}"
	# The record names every retained path, the generated body included, so the exit
	# guard's unrecorded-leak check no longer applies to it.
	body=''
}

validate_arguments "$@"
preflight
validate_content
compose_body
if [ "$operation" = preflight ]; then
	rm -- "$body" || fail 'cannot remove preflight publication body'
	body=''
	printf '%s\n' preflight-ok
	exit 0
fi
comment_url=$(post_comment)
read_comment "$comment_url"
append_ledger "review-publication-verified: $comment_url"
disposed_paths=("$summary" "$body")
if [ "$mode" = required ]; then
	disposed_paths=("$review_or_reason" "${disposed_paths[@]}")
fi
if [ -n "$payload" ]; then
	disposed_paths+=("$payload")
fi
dispose "${disposed_paths[@]}"
printf '%s\n' "$comment_url"
